{
  "seed_urls": [
    "https://www.builtin.com/jobs/remote/cybersecurity",
    "https://remoteok.com/remote-security-jobs",
    "https://weworkremotely.com/categories/remote-programming-jobs",
    "https://www.flexjobs.com/search?search=cloud+security",
    "https://www.indeed.com/q-cloud-security-l-houston,-tx-jobs.html"
  ],
  "excluded_domains": [
    "facebook.com",
    "instagram.com",
    "linkedin.com",
    "x.com",
    "twitter.com",
    "youtube.com"
  ],
  "max_pages": 25,
  "max_depth": 2,
  "max_links_per_page": 80,
  "enable_search": true,
  "search_provider": "bing_rss",
