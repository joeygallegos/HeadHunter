  "search_templates": [
    "{role} remote careers",
    "{role} {location} careers",
    "{role} {location} jobs",
    "{role} jobs greenhouse",
    "{role} jobs lever",
    "{role} jobs workday",
    "{skill} remote jobs",
    "{skill} {location} careers"
  ],
  "known_ats_hints": {
    "workday": ["myworkdayjobs.com", "workdayjobs.com"],
    "greenhouse": ["greenhouse.io"],
    "lever": ["lever.co"],
    "ashby": ["ashbyhq.com", "jobs.ashbyhq.com"],
    "smartrecruiters": ["smartrecruiters.com"],
    "icims": ["icims.com"]
  }
}
